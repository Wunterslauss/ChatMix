<Window x:Class="ChatMix.UI.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        Topmost="True"
        ShowActivated="False"
        Focusable="False"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual">
    <Border Background="#E6202020" CornerRadius="10" Padding="18,12">
        <StackPanel>
            <TextBlock x:Name="TitleText" Foreground="White" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,0,0,8"/>
            <Grid x:Name="FillTrack" Width="220" Height="10">
                <Border Background="#33FFFFFF" CornerRadius="5"/>
                <Border x:Name="FillBar" Background="#4FC3F7" CornerRadius="5" HorizontalAlignment="Left" Width="0"/>
            </Grid>
            <TextBlock x:Name="PercentText" Foreground="White" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
