<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>ChatMix</AssemblyName>
    <RootNamespace>ChatMix</RootNamespace>
    <ApplicationIcon>Assets\chatmix.ico</ApplicationIcon>
    <!--
      NOT InvariantGlobalization: WPF's text-input stack (any TextBox, including the whole
      Settings window) needs real CultureInfo data for the user's actual Windows input language
      to manage the text caret. In invariant mode that throws CultureNotFoundException the moment
      a non-English-input-language user clicks into a text field - see dotnet/runtime#54020.
    -->
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio.Wasapi" Version="2.2.1" />
    <PackageReference Include="Microsoft.Win32.Registry" Version="5.0.0" />
  </ItemGroup>

  <!--
    Combining UseWPF + UseWindowsForms makes the SDK implicitly (globally) "using" both
    System.Windows and System.Windows.Forms in every file, which collide on Application,
    MessageBox, TextBox, Button, etc. (CS0104). Drop the WinForms one from the global set;
    HotkeyService.cs and TrayIconManager.cs (the only files that need WinForms types) add
    their own local "using System.Windows.Forms;" instead.
  -->
  <ItemGroup>
    <Using Remove="System.Windows.Forms" />
  </ItemGroup>

</Project>
